<config>
  <pid-file>/var/run/simp/simp.pid</pid-file>
  <redis host="127.0.0.1" port="6379"/>

  <!-- Hash ring settings are injected at runtime via env vars:
       SIMP_POLLER_ID     - index of this poller instance (0-based)
       SIMP_TOTAL_POLLERS - total number of poller instances
       See conf/k8s/poller-deployment.yaml for the Helm template that sets these. -->

  <group name="group-a" active="1" workers="2" poll_interval="60">
    <mib oid="1.3.6.1.2.1.2.2.1"/>
    <mib oid="1.3.6.1.2.1.1.3"/>
    <host ip="10.0.2.1" community="public"/>
    <host ip="10.0.2.2" community="public"/>
    <host ip="10.0.2.3" community="public"/>
    <host ip="10.0.2.4" community="public"/>
    <host ip="10.0.2.5" community="public"/>
    <host ip="10.0.2.6" community="public"/>
  </group>

</config>
